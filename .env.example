# 이 파일을 .env로 복사한 뒤 사용할 Provider의 값만 채우세요.
# 실제 키/시크릿은 절대 커밋하지 마세요. (.env는 .gitignore에 등록되어 있습니다)
# 모의투자 모드는 V 접미사 키(LSV_APP_KEY 등)를 사용하며 실전 키로 대체하지 않습니다.
# OAuth 성공 시 발급된 토큰이 같은 이름 규칙으로 .env에 자동 저장됩니다. (예: KIS_ACCESS_TOKEN, 모의투자는 KISV_ACCESS_TOKEN)
KIS_APP_KEY=YOUR_APP_KEY
KIS_APP_SECRET=YOUR_APP_SECRET
KISV_APP_KEY=YOUR_APP_KEY
KISV_APP_SECRET=YOUR_APP_SECRET
LS_APP_KEY=YOUR_APP_KEY
LS_APP_SECRET=YOUR_APP_SECRET
LSV_APP_KEY=YOUR_APP_KEY
LSV_APP_SECRET=YOUR_APP_SECRET
KIWOOM_APP_KEY=YOUR_APP_KEY
KIWOOM_APP_SECRET=YOUR_APP_SECRET
KIWOOMV_APP_KEY=YOUR_APP_KEY
KIWOOMV_APP_SECRET=YOUR_APP_SECRET
NH_APP_KEY=YOUR_APP_KEY
NH_APP_SECRET=YOUR_APP_SECRET
NHV_APP_KEY=YOUR_APP_KEY
NHV_APP_SECRET=YOUR_APP_SECRET
DB_APP_KEY=YOUR_APP_KEY
DB_APP_SECRET=YOUR_APP_SECRET
DBV_APP_KEY=YOUR_APP_KEY
DBV_APP_SECRET=YOUR_APP_SECRET
