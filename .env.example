KIS_APP_SECRET=YOUR_APP_SECRET
KISV_APP_KEY=YOUR_APP_KEY
KISV_APP_SECRET=YOUR_APP_SECRET
KIWOOM_APP_KEY=YOUR_APP_KEY
KIWOOM_APP_SECRET=YOUR_APP_SECRET
KIWOOMV_APP_KEY=YOUR_APP_KEY
KIWOOMV_APP_SECRET=YOUR_APP_SECRET
NH_APP_KEY=YOUR_APP_KEY
NH_APP_SECRET=YOUR_APP_SECRET
NHV_APP_KEY=YOUR_APP_KEY
NHV_APP_SECRET=YOUR_APP_SECRET
DB_APP_KEY=YOUR_APP_KEY
